# DevHub API - environment variables (copy to .env or export in your shell)

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development

# Connection string for PostgreSQL
# Local development default: Host=localhost;Database=devhub;Username=devhub;Password=
ConnectionStrings__Default=Host=localhost;Database=devhub;Username=devhub;Password=

# Design-time / EF Core (used by DesignTimeDbContextFactory when no host config is available)
DEVHUB_CONNECTIONSTRING=Host=localhost;Database=devhub;Username=devhub;Password=
# DEVHUB_DB_HOST=localhost
# DEVHUB_DB_NAME=devhub
# DEVHUB_DB_USER=devhub
# DEVHUB_DB_PASSWORD=

# JWT — REQUIRED. Use a strong secret of at least 32 bytes.
# Production: generate a random value, e.g. `openssl rand -base64 48`
Jwt__SecretKey=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
Jwt__Issuer=DevHub
Jwt__Audience=DevHub.Client
Jwt__AccessTokenLifetimeMinutes=15
Jwt__RefreshTokenLifetimeDays=7

# CORS
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:3000

# Apply migrations automatically on startup (hosting + integration tests). Keep false when running migrations manually.
Database__AutoMigrate=false

# Seed a development admin user on startup (dev only — never in production)
Seed__CreateAdminUser=false
Seed__AdminEmail=
Seed__AdminPassword=