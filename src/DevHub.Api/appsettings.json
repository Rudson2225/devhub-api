{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=devhub;Username=devhub;Password="
  },
  "Jwt": {
    "Issuer": "DevHub",
    "Audience": "DevHub.Client",
    "SecretKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "RequireHeaderSymmetry": false
  },
  "RateLimit": {
    "AuthPolicy": {
      "PermitLimit": 10,
      "AccountPermitLimit": 20,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Database": {
    "AutoMigrate": false
  },
  "Seed": {
    "CreateAdminUser": false,
    "AdminEmail": "",
    "AdminPassword": ""
  }
}